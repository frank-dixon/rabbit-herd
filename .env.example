DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
# Previous SECRET_KEY values, comma-separated. Leave empty until you rotate.
SECRET_KEY_FALLBACKS=
DATABASE_URL=postgres://rabbit:rabbit@localhost:5432/rabbit_herd
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Rabbit Herd
WEBAUTHN_ORIGIN=http://localhost:8000
# Stable public host. No scheme and no port. Passkeys use this when it is set.
# APP_HOSTNAME=your-app.example.com
# Vercel sets these when system environment variables are enabled.
# VERCEL_PROJECT_PRODUCTION_URL is the stable production host.
# VERCEL_URL is this deployment's host.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=replace-with-a-password
DEFAULT_FROM_EMAIL=Rabbit Herd <noreply@example.com>
# Outgoing mail. Leave EMAIL_PROVIDER unset locally to print messages in the terminal.
# On the host, set EMAIL_PROVIDER=resend and RESEND_API_KEY. Until a domain you
# control is verified, DEFAULT_FROM_EMAIL must be onboarding@resend.dev, and
# Resend delivers only to the email address on the Resend account.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# SMTP still works. It is used when EMAIL_PROVIDER=smtp, or when EMAIL_PROVIDER
# is unset and EMAIL_HOST is set.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
